# ===== نسخة من هذا الملف باسم .env داخل VM أوراكل =====
# أسرار حقيقية فقط على الجهاز — لا ترفع أبداً إلى git.
CBOT_ENVIRONMENT=demo
CBOT_MODE=trade

# بيانات تطبيق OpenAPI (بوابة id.ctraderapi.com):
CBOT_APP_CLIENT_ID=CHANGE_ME
CBOT_APP_CLIENT_SECRET=CHANGE_ME
# رموز الوصول (long-lived؛ تُحدَّث عبر CBOT_TOKEN_SYNC عند انتهائها):
CBOT_ACCESS_TOKEN=CHANGE_ME
CBOT_REFRESH_TOKEN=CHANGE_ME

# وضع المراقبة (إيقاف الفتح): 1 = راقب فقط، 0 = تداول حي
STRAT_PAUSE_OPEN=1

# نموذج الإشارة: v1 حالياً (v2 بعد forward-test ناجح)
STRAT_MODEL=v1
# تقييم v2 الافتراضي (يسجل قراراته بلا فتح صفقة)
STRAT_V2_EVAL=1

# مدة الحلقة: دائم (لا توقف ذاتي) — systemd يعيد التشغيل عند أي موت
CBOT_DURATION_MIN=9999
CBOT_GLOBAL_POLL_SEC=3